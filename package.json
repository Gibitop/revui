{
  "name": "revui",
  "version": "0.1.0",
  "private": true,
  "description": "A local workspace for thoughtful code review",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "pnpm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "setup": "node scripts/setup.mjs",
    "test:benchmark": "pnpm run build && node scripts/benchmark.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.25.0 <12"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@opencode/client": "2.0.18",
    "@pierre/diffs": "^1.4.3",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.103.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "1.47.0",
    "node-emoji": "^2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.0",
    "typescript-fallback": "npm:typescript@5.9.3",
    "typescript-language-server": "^6.0.1",
    "unist-util-visit": "^5.1.0",
    "vscode-jsonrpc": "^9.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.4",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
